  <project name="sethome2/gprMax_docker" path="gprMax_docker" revision="main" />
  <project name="sethome2/gprMax-Workbench" path="gprMax-Workbench" revision="main" />
  <project name="sethome2/gprMax_in_doc" path="gprMax_in_doc" revision="main" />
